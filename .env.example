# Vercel Postgres / Neon connection variables are provided by the database integration.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Generate a random value of at least 32 characters for signed member sessions.
MEMBERSHIP_SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated authorized administrator emails. Do not expose this in frontend code.
MEMBERSHIP_ADMIN_EMAILS=admin@example.com

# Local development Mailpit / SMTP configuration. These values belong in
# .env.local and must not be copied into a production deployment.
# Mailpit uses plain SMTP with no authentication or TLS during local development.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yangasc.local
SMTP_FROM_NAME=Young Africans SC
SMTP_TIMEOUT_MS=10000

# OTP security controls.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_RATE_WINDOW_MINUTES=15
OTP_RATE_LIMIT=5
OTP_HASH_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
