# Production-only SMTP configuration. Set these values in the hosting
# provider's environment; do not use the local Mailpit values from .env.local.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_AUTH=true
SMTP_USER=replace-with-production-smtp-user
SMTP_PASSWORD=replace-with-production-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Young Africans SC
SMTP_TIMEOUT_MS=10000
